// Version information of the DLL (Properties > Details). CMake fills it in from
// apworld/bioshock_infinite/archipelago.json (world_version).

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @BSAP_VERSION_COMMAS@,0
PRODUCTVERSION @BSAP_VERSION_COMMAS@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "BioShock Infinite Archipelago mod"
            VALUE "FileVersion", "@BSAP_VERSION@"
            VALUE "InternalName", "BioShockAP"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "xinput1_3.dll"
            VALUE "ProductName", "BioShock Infinite Archipelago"
            VALUE "ProductVersion", "@BSAP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
